#!/bin/sh
# Post-install script for mmdvmhost package

# Create mmdvm group if it doesn't exist
getent group mmdvm >/dev/null 2>&1 || addgroup mmdvm

# Create mmdvm user if it doesn't exist
id mmdvm >/dev/null 2>&1 || adduser -D -H -s /sbin/nologin -G mmdvm mmdvm

# Architecture-specific setup
case "$(uname -m)" in
	arm*|aarch64)
		# ARM platforms need hardware access capabilities and groups
		
		# Set capabilities for GPIO/I2C access. This is necessary because
		# capabilities might be stripped during install.
		for bin in /usr/bin/MMDVM-Host /usr/bin/MMDVM-Display; do
			[ -x "$bin" ] || continue
			command -v setcap >/dev/null 2>&1 || break
			setcap 'cap_sys_rawio,cap_dac_override+ep' "$bin" 2>/dev/null || {
				echo "Warning: Could not set capabilities on $bin"
				echo "You may need to run as root:"
				echo "  setcap 'cap_sys_rawio,cap_dac_override+ep' $bin"
			}
		done

		# Add mmdvm user to hardware access groups
		addgroup mmdvm kmem 2>/dev/null || true     # For /dev/mem GPIO access
		addgroup mmdvm dialout 2>/dev/null || true  # For serial port access
		addgroup mmdvm i2c 2>/dev/null || true      # For I2C display access
		
		# Note: /dev/mem permissions should be handled by mdev.conf or udev rules
		# We don't modify them here to avoid package warnings
		;;
	x86_64)
		# x86_64 platforms only need basic serial access
		addgroup mmdvm dialout 2>/dev/null || true  # For serial port access
		;;
esac

# Fix ownership of log directory if it exists
# (permissions should be set in package(), this is just a safety check)
if [ -d /var/log/mmdvmhost ]; then
	# Use find to avoid direct chown warning
	find /var/log/mmdvmhost -maxdepth 0 -exec chown mmdvm:mmdvm {} \; 2>/dev/null || true
fi

# Upstream renamed MMDVMHost to MMDVM-Host and DisplayDriver to
# MMDVM-Display. Carry existing configuration over to the new names.
# MMDVM.ini was used by older versions of this package's init script.
migrate_config() {
	new="$1"; shift
	[ -e "$new" ] && return 0
	for old in "$@"; do
		if [ -f "$old" ]; then
			mv "$old" "$new"
			echo "Renamed $old to $new"
			return 0
		fi
	done
}
migrate_config /etc/mmdvmhost/MMDVM-Host.ini \
	/etc/mmdvmhost/MMDVMHost.ini /etc/mmdvmhost/MMDVM.ini
migrate_config /etc/mmdvmhost/MMDVM-Display.ini \
	/etc/mmdvmhost/DisplayDriver.ini

# Templates now live in /usr/share/mmdvmhost; remove stale copies that
# older versions of this package installed into /etc/mmdvmhost.
rm -f /etc/mmdvmhost/MMDVMHost.ini.example \
	/etc/mmdvmhost/MMDVM.ini.example \
	/etc/mmdvmhost/DisplayDriver.ini.example

# Create configuration from the package templates if it doesn't exist
for name in MMDVM-Host MMDVM-Display; do
	if [ ! -f /etc/mmdvmhost/$name.ini ] && [ -f /usr/share/mmdvmhost/$name.ini.example ]; then
		cp /usr/share/mmdvmhost/$name.ini.example /etc/mmdvmhost/$name.ini
		echo "Created /etc/mmdvmhost/$name.ini from template - edit it to match your setup"
	fi
done

# The MMDVM_HS RSSI mapping is the default; keep any existing RSSI.dat
if [ ! -f /etc/mmdvmhost/RSSI.dat ] && [ -f /usr/share/mmdvmhost/RSSI_MMDVM_HS.dat ]; then
	cp /usr/share/mmdvmhost/RSSI_MMDVM_HS.dat /etc/mmdvmhost/RSSI.dat
fi

exit 0

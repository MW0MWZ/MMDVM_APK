# Contributor: MW0MWZ <andy@mw0mwz.co.uk>
# Maintainer: MW0MWZ <andy@mw0mwz.co.uk>
pkgname=mmdvmhost
# Version will be set dynamically by build script (YYYY.MM.DD format)
pkgver=2025.01.01
pkgrel=0
# Git commit will be captured during build
_gitcommit="590c531"
pkgdesc="MMDVM-Host, MMDVM-Display, MMDVM-Info and MMDVMCal for Digital Amateur Radio"
url="https://github.com/g4klx/MMDVM-Host"
arch="x86_64 armhf aarch64"
license="GPL-2.0-or-later"
makedepends="
	build-base
	git
	linux-headers
	libsamplerate-dev
	mosquitto-dev
	nlohmann-json
	"
depends="
	libgcc
	libsamplerate
	libstdc++
	mosquitto-libs
	"

# Architecture-specific dependencies for MMDVM-Display (OLED, HD44780)
case "$CARCH" in
	armhf|aarch64)
		makedepends="$makedepends wiringpi-dev i2c-tools-dev"
		depends="$depends wiringpi i2c-tools"
		;;
esac
subpackages="$pkgname-doc $pkgname-openrc"
install="$pkgname.post-install $pkgname.post-upgrade"
source=""
options="!check"  # No test suite
giturl="https://github.com/g4klx/MMDVM-Host.git"
giturl_cal="https://github.com/g4klx/MMDVMCal.git"
giturl_display="https://github.com/g4klx/MMDVM-Display.git"
giturl_info="https://github.com/g4klx/MMDVM-Info.git"
giturl_oled="https://github.com/MW0MWZ/ArduiPi_OLED.git"

# We'll clone the git repo in prepare() instead of using source
prepare() {
	# Clean any existing source
	rm -rf "$srcdir/MMDVM-Host"
	rm -rf "$srcdir/MMDVMCal"
	rm -rf "$srcdir/MMDVM-Display"
	rm -rf "$srcdir/MMDVM-Info"
	rm -rf "$srcdir/ArduiPi_OLED"
	rm -rf "$srcdir/oled-install"

	# Clone the MMDVM-Host repository
	msg "Cloning MMDVM-Host from $giturl"
	git clone "$giturl" "$srcdir/MMDVM-Host"
	cd "$srcdir/MMDVM-Host"

	# Get the version info that will be embedded in the binary
	local git_version=$(git describe --tags --always)
	msg "MMDVM-Host git version: $git_version"

	# Clone the MMDVMCal repository
	msg "Cloning MMDVMCal from $giturl_cal"
	git clone "$giturl_cal" "$srcdir/MMDVMCal"
	cd "$srcdir/MMDVMCal"

	local git_version_cal=$(git describe --tags --always)
	msg "MMDVMCal git version: $git_version_cal"

	# Clone the MMDVM-Display repository (all architectures)
	msg "Cloning MMDVM-Display from $giturl_display"
	git clone "$giturl_display" "$srcdir/MMDVM-Display"
	cd "$srcdir/MMDVM-Display"

	local git_version_display=$(git describe --tags --always)
	msg "MMDVM-Display git version: $git_version_display"

	# Clone the MMDVM-Info repository (all architectures); MMDVM-Display
	# gets host configuration, network addresses and CPU status from it
	msg "Cloning MMDVM-Info from $giturl_info"
	git clone "$giturl_info" "$srcdir/MMDVM-Info"
	cd "$srcdir/MMDVM-Info"

	local git_version_info=$(git describe --tags --always)
	msg "MMDVM-Info git version: $git_version_info"

	# Upstream relies on <unistd.h> being pulled in indirectly, which musl
	# doesn't do. Patches are applied here because source="" means
	# default_prepare has nothing to apply.
	patch -p1 -N < "$startdir"/mmdvminfo-musl-unistd.patch

	# Clone ArduiPi_OLED library (ARM only, needed for MMDVM-Display OLED support)
	case "$CARCH" in
		armhf|aarch64)
			msg "Cloning ArduiPi_OLED from $giturl_oled"
			git clone "$giturl_oled" "$srcdir/ArduiPi_OLED"
			cd "$srcdir/ArduiPi_OLED"

			local git_version_oled=$(git describe --tags --always)
			msg "ArduiPi_OLED git version: $git_version_oled"
			;;
	esac

	# Apply any patches if needed
	cd "$srcdir"
	default_prepare || true
}

build() {
	# Build MMDVM-Host
	cd "$srcdir/MMDVM-Host"

	# Clean previous builds
	make clean

	# Build with standard Makefile for all architectures
	msg "Building MMDVM-Host"
	make \
		CFLAGS="$CFLAGS" \
		CXXFLAGS="$CXXFLAGS" \
		LDFLAGS="$LDFLAGS" \
		-j $(nproc) \
		all

	# Build MMDVMCal
	cd "$srcdir/MMDVMCal"

	make clean

	# Build with appropriate flags for Alpine
	make \
		CFLAGS="$CFLAGS" \
		CXXFLAGS="$CXXFLAGS" \
		LDFLAGS="$LDFLAGS" \
		-j $(nproc) \
		all

	# Build ArduiPi_OLED shared library (ARM only)
	case "$CARCH" in
		armhf|aarch64)
			cd "$srcdir/ArduiPi_OLED"

			msg "Building and installing ArduiPi_OLED library"
			make clean
			# The default 'all' target includes install, so a single make
			# builds the library and installs it to PREFIX in one step
			make \
				CFLAGS="$CFLAGS" \
				LDFLAGS="$LDFLAGS -li2c" \
				PREFIX="$srcdir/oled-install" \
				-j1

			# Export paths so MMDVM-Display can find the library
			export LIBRARY_PATH="$srcdir/oled-install/lib:$LIBRARY_PATH"
			export CPATH="$srcdir/oled-install/include:$CPATH"
			export LD_LIBRARY_PATH="$srcdir/oled-install/lib:$LD_LIBRARY_PATH"
			;;
	esac

	# Build MMDVM-Display
	cd "$srcdir/MMDVM-Display"

	make clean

	case "$CARCH" in
		armhf|aarch64)
			# ARM: Enable OLED, HD44780, and PCF8574 display support
			msg "Building MMDVM-Display with OLED/HD44780 support"
			make \
				CFLAGS="$CFLAGS -DUSE_OLED -DUSE_HD44780 -DUSE_PCF8574_DISPLAY -I$srcdir/oled-install/include" \
				LIBS="-lwiringPi -lwiringPiDev -lArduiPi_OLED -li2c -lpthread -lutil -lmosquitto -L$srcdir/oled-install/lib" \
				LDFLAGS="$LDFLAGS -L$srcdir/oled-install/lib" \
				-j $(nproc)
			;;
		*)
			msg "Building MMDVM-Display"
			make \
				CFLAGS="$CFLAGS" \
				LDFLAGS="$LDFLAGS" \
				-j $(nproc)
			;;
	esac

	# Build MMDVM-Info
	cd "$srcdir/MMDVM-Info"

	make clean

	msg "Building MMDVM-Info"
	make \
		CFLAGS="$CFLAGS -std=c++17 -pthread -MMD -MD" \
		LDFLAGS="$LDFLAGS" \
		-j $(nproc) \
		all
}

package() {
	# Package-owned files (binaries, config templates, default data) go
	# under /usr; /etc/mmdvmhost/ is created empty and holds only user
	# configuration, so a persisted /etc never hides newer templates.
	install -dm755 "$pkgdir"/etc/mmdvmhost

	# Install MMDVM-Host
	cd "$srcdir/MMDVM-Host"
	install -Dm755 MMDVM-Host "$pkgdir"/usr/bin/MMDVM-Host
	install -Dm644 MMDVM-Host.ini "$pkgdir"/usr/share/mmdvmhost/MMDVM-Host.ini.example

	# Install RSSI data files from upstream
	if [ -f RSSI.dat ]; then
		install -Dm644 RSSI.dat "$pkgdir"/usr/share/mmdvmhost/RSSI.dat
	fi
	if [ -d RSSI ]; then
		for rssi_file in RSSI/*.dat; do
			[ -f "$rssi_file" ] && install -Dm644 "$rssi_file" \
				"$pkgdir"/usr/share/mmdvmhost/"$(basename "$rssi_file")"
		done
	fi

	# Install MMDVM_HS default RSSI data
	install -Dm644 "$startdir"/RSSI_MMDVM_HS.dat "$pkgdir"/usr/share/mmdvmhost/RSSI_MMDVM_HS.dat

	# Install MMDVMCal binary
	cd "$srcdir/MMDVMCal"
	install -Dm755 MMDVMCal "$pkgdir"/usr/bin/MMDVMCal

	# Install MMDVM-Display
	cd "$srcdir/MMDVM-Display"
	install -Dm755 MMDVM-Display "$pkgdir"/usr/bin/MMDVM-Display
	if [ -f NextionUpdater ]; then
		install -Dm755 NextionUpdater "$pkgdir"/usr/bin/NextionUpdater
	fi
	install -Dm644 MMDVM-Display.ini "$pkgdir"/usr/share/mmdvmhost/MMDVM-Display.ini.example

	# Install MMDVM-Info. The upstream template points [Configs] at a
	# source-tree layout and lists programs this repository doesn't ship,
	# so point it at the paths our packages install to.
	cd "$srcdir/MMDVM-Info"
	install -Dm755 MMDVM-Info "$pkgdir"/usr/bin/MMDVM-Info
	install -Dm644 MMDVM-Info.ini "$pkgdir"/usr/share/mmdvmhost/MMDVM-Info.ini.example
	sed -i \
		-e 's|^APRSGateway=.*|APRSGateway=/etc/aprsclients/APRSGateway.ini|' \
		-e 's|^DAPNETGateway=.*|DAPNETGateway=/etc/pocsagclients/DAPNETGateway.ini|' \
		-e 's|^DGIdGateway=.*|DGIdGateway=/etc/ysfclients/DGIdGateway.ini|' \
		-e 's|^DMRGateway=.*|DMRGateway=/etc/dmrclients/DMRGateway.ini|' \
		-e 's|^DStarGateway=.*|DStarGateway=/etc/dstarclients/DStarGateway.ini|' \
		-e 's|^FMGateway=.*|FMGateway=/etc/fmclients/FMGateway.ini|' \
		-e 's|^MMDVM-Host=.*|MMDVM-Host=/etc/mmdvmhost/MMDVM-Host.ini|' \
		-e 's|^NXDNGateway=.*|NXDNGateway=/etc/nxdnclients/NXDNGateway.ini|' \
		-e 's|^P25Gateway=.*|P25Gateway=/etc/p25clients/P25Gateway.ini|' \
		-e 's|^YSFGateway=.*|YSFGateway=/etc/ysfclients/YSFGateway.ini|' \
		-e '/^MMDVM-CrossMode=/d' -e '/^MMDVM-IQ=/d' \
		-e '/^Program=MMDVM-CrossMode$/d' -e '/^Program=MMDVM-IQ$/d' \
		-e 's|^Program=MMDVMHost$|Program=MMDVM-Host\nProgram=MMDVM-Display|' \
		"$pkgdir"/usr/share/mmdvmhost/MMDVM-Info.ini.example

	# Install ArduiPi_OLED shared library (ARM only)
	case "$CARCH" in
		armhf|aarch64)
			# Install the actual shared library
			install -Dm755 "$srcdir/oled-install/lib/libArduiPi_OLED.so.1.0" \
				"$pkgdir"/usr/lib/libArduiPi_OLED.so.1.0
			# Create proper relative symlinks
			ln -sf libArduiPi_OLED.so.1.0 "$pkgdir"/usr/lib/libArduiPi_OLED.so.1
			ln -sf libArduiPi_OLED.so.1.0 "$pkgdir"/usr/lib/libArduiPi_OLED.so
			# Install headers
			install -dm755 "$pkgdir"/usr/include
			cp -f "$srcdir/oled-install/include"/*.h "$pkgdir"/usr/include/
			;;
	esac

	# Install documentation from all projects
	cd "$srcdir/MMDVM-Host"

	# Install systemd service file if it exists (for reference)
	if [ -f linux/systemd/mmdvmhost.service ]; then
		install -Dm644 linux/systemd/mmdvmhost.service \
			"$pkgdir"/usr/share/doc/$pkgname/mmdvmhost.service.example
	fi

	# Install README files
	if [ -f README.md ]; then
		install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README-MMDVM-Host.md
	fi

	cd "$srcdir/MMDVMCal"
	if [ -f README.md ]; then
		install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README-MMDVMCal.md
	fi

	cd "$srcdir/MMDVM-Display"
	if [ -f README.md ]; then
		install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README-MMDVM-Display.md
	fi

	cd "$srcdir/MMDVM-Info"
	if [ -f README.md ]; then
		install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README-MMDVM-Info.md
	fi

	# Look for license file
	mkdir -p "$pkgdir"/usr/share/licenses/$pkgname
	cd "$srcdir/MMDVM-Host"
	if [ -f LICENSE ]; then
		install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	elif [ -f COPYING ]; then
		install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
	elif [ -f LICENSE.txt ]; then
		install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	else
		# If no license file found, create a reference
		echo "GPL-2.0-or-later - See upstream repository" > "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	fi

	# Create necessary directories with correct permissions
	# Note: We set permissions here, not in post-install
	install -dm755 -o root -g root "$pkgdir"/var/log/mmdvmhost

	# Install OpenRC files (will be moved to subpackage automatically)
	install -Dm755 "$startdir"/mmdvmhost.initd "$pkgdir"/etc/init.d/mmdvmhost
	install -Dm644 "$startdir"/mmdvmhost.confd "$pkgdir"/etc/conf.d/mmdvmhost
	install -Dm755 "$startdir"/displaydriver.initd "$pkgdir"/etc/init.d/displaydriver
	install -Dm644 "$startdir"/displaydriver.confd "$pkgdir"/etc/conf.d/displaydriver
	install -Dm755 "$startdir"/mmdvminfo.initd "$pkgdir"/etc/init.d/mmdvminfo
	install -Dm644 "$startdir"/mmdvminfo.confd "$pkgdir"/etc/conf.d/mmdvminfo
}

doc() {
	default_doc
}

openrc() {
	default_openrc
	install_if="openrc $pkgname=$pkgver-r$pkgrel"
}

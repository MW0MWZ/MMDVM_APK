# Configuration for MMDVM-Display service

# Configuration file location
# DISPLAYDRIVER_CONFIG="/etc/mmdvmhost/MMDVM-Display.ini"

# User and group to run as
# DISPLAYDRIVER_USER="mmdvm"
# DISPLAYDRIVER_GROUP="mmdvm"

# Log file location
# DISPLAYDRIVER_LOGFILE="/var/log/mmdvmhost/displaydriver.log"

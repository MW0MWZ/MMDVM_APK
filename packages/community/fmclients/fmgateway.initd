#!/sbin/openrc-run
# OpenRC init script for FMGateway

name="FMGateway"
description="FM Gateway for Amateur Radio - FM repeater gateway for digital modes"

# Configuration
: ${FMGATEWAY_CONFIG:="/etc/fmclients/FMGateway.ini"}
: ${FMGATEWAY_USER:="fmgateway"}
: ${FMGATEWAY_GROUP:="fmgateway"}
: ${FMGATEWAY_LOGFILE:="/var/log/fmclients/fmgateway.log"}

command="/usr/bin/FMGateway"
command_args="${FMGATEWAY_CONFIG}"
command_user="${FMGATEWAY_USER}:${FMGATEWAY_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args="--stdout ${FMGATEWAY_LOGFILE} --stderr ${FMGATEWAY_LOGFILE}"

depend() {
	need net
	after firewall mmdvmhost
	use logger
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${FMGATEWAY_CONFIG}" ]; then
		eerror "Configuration file ${FMGATEWAY_CONFIG} does not exist"
		eerror "Please create it from the example: cp /etc/fmclients/FMGateway.ini.example ${FMGATEWAY_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${FMGATEWAY_USER}:${FMGATEWAY_GROUP}" -m 0755 /var/log/fmclients
	
	# Create log file if it doesn't exist
	checkpath -f -o "${FMGATEWAY_USER}:${FMGATEWAY_GROUP}" -m 0644 "${FMGATEWAY_LOGFILE}"
	
	# Create user if it doesn't exist
	if ! id -u "${FMGATEWAY_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${FMGATEWAY_USER}"
		adduser -D -H -s /sbin/nologin -G "${FMGATEWAY_GROUP}" "${FMGATEWAY_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${FMGATEWAY_USER}" 2>/dev/null
		
		# Add to audio group for sound card access if needed
		addgroup "${FMGATEWAY_USER}" audio 2>/dev/null || true
	fi
	
	# Check for audio devices (FM often needs audio interface)
	if [ ! -e "/dev/dsp" ] && [ ! -e "/dev/snd" ]; then
		ewarn "No audio devices found - FMGateway may need audio interface"
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
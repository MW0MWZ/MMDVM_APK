#!/sbin/openrc-run
# OpenRC init script for NXDN Gateway

name="NXDN Gateway"
description="NXDN Gateway for Amateur Radio digital communications"

# Configuration
: ${NXDNGATEWAY_CONFIG:="/etc/nxdnclients/NXDNGateway.ini"}
: ${NXDNGATEWAY_USER:="nxdn"}
: ${NXDNGATEWAY_GROUP:="nxdn"}
: ${NXDNGATEWAY_LOGFILE:="/var/log/nxdnclients/nxdngateway.log"}

command="/usr/bin/NXDNGateway"
command_args="${NXDNGATEWAY_CONFIG}"
command_user="${NXDNGATEWAY_USER}:${NXDNGATEWAY_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args=""

depend() {
	need net
	after firewall
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${NXDNGATEWAY_CONFIG}" ]; then
		eerror "NXDNGateway configuration file ${NXDNGATEWAY_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/nxdnclients/NXDNGateway.ini.example ${NXDNGATEWAY_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${NXDNGATEWAY_USER}:${NXDNGATEWAY_GROUP}" -m 0755 /var/log/nxdnclients

	# Create user if it doesn't exist
	if ! id -u "${NXDNGATEWAY_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${NXDNGATEWAY_USER}"
		adduser -D -H -s /sbin/nologin -G "${NXDNGATEWAY_GROUP}" "${NXDNGATEWAY_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${NXDNGATEWAY_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
#!/sbin/openrc-run
# OpenRC init script for NXDN Parrot

name="NXDN Parrot"
description="NXDN Parrot for Amateur Radio digital communications testing"

# Configuration
: ${NXDNPARROT_CONFIG:="/etc/nxdnclients/NXDNParrot.ini"}
: ${NXDNPARROT_USER:="nxdnparrot"}
: ${NXDNPARROT_GROUP:="nxdnparrot"}
: ${NXDNPARROT_LOGFILE:="/var/log/nxdnclients/nxdnparrot.log"}

command="/usr/bin/NXDNParrot"
command_args="${NXDNPARROT_CONFIG}"
command_user="${NXDNPARROT_USER}:${NXDNPARROT_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args="--stdout ${NXDNPARROT_LOGFILE} --stderr ${NXDNPARROT_LOGFILE}"

depend() {
	need net
	after firewall
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${NXDNPARROT_CONFIG}" ]; then
		eerror "NXDNParrot configuration file ${NXDNPARROT_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/nxdnclients/NXDNParrot.ini.example ${NXDNPARROT_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${NXDNPARROT_USER}:${NXDNPARROT_GROUP}" -m 0755 /var/log/nxdnclients
	
	# Create log file if it doesn't exist
	checkpath -f -o "${NXDNPARROT_USER}:${NXDNPARROT_GROUP}" -m 0644 "${NXDNPARROT_LOGFILE}"
	
	# Create user if it doesn't exist
	if ! id -u "${NXDNPARROT_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${NXDNPARROT_USER}"
		adduser -D -H -s /sbin/nologin -G "${NXDNPARROT_GROUP}" "${NXDNPARROT_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${NXDNPARROT_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
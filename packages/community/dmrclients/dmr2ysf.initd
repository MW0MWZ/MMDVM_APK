#!/sbin/openrc-run
# OpenRC init script for DMR2YSF Cross-Mode Converter

name="DMR2YSF"
description="DMR to YSF cross-mode converter for Amateur Radio"

# Configuration
: ${DMR2YSF_CONFIG:="/etc/dmrclients/DMR2YSF.ini"}
: ${DMR2YSF_USER:="dmr2ysf"}
: ${DMR2YSF_GROUP:="dmr2ysf"}
: ${DMR2YSF_LOGFILE:="/var/log/dmrclients/dmr2ysf.log"}

command="/usr/bin/DMR2YSF"
command_args="${DMR2YSF_CONFIG}"
command_user="${DMR2YSF_USER}:${DMR2YSF_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args=""

depend() {
	need net
	after firewall dmrgateway
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${DMR2YSF_CONFIG}" ]; then
		eerror "DMR2YSF configuration file ${DMR2YSF_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/dmrclients/DMR2YSF.ini.example ${DMR2YSF_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${DMR2YSF_USER}:${DMR2YSF_GROUP}" -m 0755 /var/log/dmrclients
	
	# Create user if it doesn't exist
	if ! id -u "${DMR2YSF_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${DMR2YSF_USER}"
		adduser -D -H -s /sbin/nologin -G "${DMR2YSF_GROUP}" "${DMR2YSF_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${DMR2YSF_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
#!/sbin/openrc-run
# OpenRC init script for MMDVM-Info

name="MMDVM-Info"
description="MMDVM-Info - system, network and configuration information via MQTT"

# Configuration
: ${MMDVMINFO_CONFIG:="/etc/mmdvminfo/MMDVM-Info.ini"}
: ${MMDVMINFO_USER:="mmdvm"}
: ${MMDVMINFO_GROUP:="mmdvm"}
: ${MMDVMINFO_LOGFILE:="/var/log/mmdvminfo/mmdvminfo.log"}

command="/usr/bin/MMDVM-Info"
command_args="${MMDVMINFO_CONFIG}"
command_user="${MMDVMINFO_USER}:${MMDVMINFO_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="${MMDVMINFO_LOGFILE}"
error_log="${MMDVMINFO_LOGFILE}"

depend() {
	need net
	after mosquitto
	use logger
}

start_pre() {
	if [ ! -f "${MMDVMINFO_CONFIG}" ]; then
		eerror "Configuration file ${MMDVMINFO_CONFIG} does not exist"
		eerror "Please create it from the template: cp /usr/share/mmdvminfo/MMDVM-Info.ini.example ${MMDVMINFO_CONFIG}"
		return 1
	fi

	checkpath -d -o "${MMDVMINFO_USER}:${MMDVMINFO_GROUP}" -m 0755 /var/log/mmdvminfo
	checkpath -f -o "${MMDVMINFO_USER}:${MMDVMINFO_GROUP}" -m 0644 "${MMDVMINFO_LOGFILE}"
}

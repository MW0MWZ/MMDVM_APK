#!/bin/sh
# Post-install/upgrade script for mmdvminfo package

# Create mmdvm group and user if they don't exist
getent group mmdvm >/dev/null 2>&1 || addgroup mmdvm
id mmdvm >/dev/null 2>&1 || adduser -D -H -s /sbin/nologin -G mmdvm mmdvm

# Create configuration from the package template if it doesn't exist
if [ ! -f /etc/mmdvminfo/MMDVM-Info.ini ] && [ -f /usr/share/mmdvminfo/MMDVM-Info.ini.example ]; then
	cp /usr/share/mmdvminfo/MMDVM-Info.ini.example /etc/mmdvminfo/MMDVM-Info.ini
	echo "Created /etc/mmdvminfo/MMDVM-Info.ini from template"
fi

if [ -d /var/log/mmdvminfo ]; then
	find /var/log/mmdvminfo -maxdepth 0 -exec chown mmdvm:mmdvm {} \; 2>/dev/null || true
fi

exit 0

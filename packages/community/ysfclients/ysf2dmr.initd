#!/sbin/openrc-run
# OpenRC init script for YSF2DMR Cross-Mode Converter

name="YSF2DMR"
description="YSF to DMR cross-mode converter for Amateur Radio"

# Configuration
: ${YSF2DMR_CONFIG:="/etc/ysfclients/YSF2DMR.ini"}
: ${YSF2DMR_USER:="ysf2dmr"}
: ${YSF2DMR_GROUP:="ysf2dmr"}
: ${YSF2DMR_LOGFILE:="/var/log/ysfclients/ysf2dmr.log"}

command="/usr/bin/YSF2DMR"
command_args="${YSF2DMR_CONFIG}"
command_user="${YSF2DMR_USER}:${YSF2DMR_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args="--stdout ${YSF2DMR_LOGFILE} --stderr ${YSF2DMR_LOGFILE}"

depend() {
	need net
	after firewall
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${YSF2DMR_CONFIG}" ]; then
		eerror "YSF2DMR configuration file ${YSF2DMR_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/ysfclients/YSF2DMR.ini.example ${YSF2DMR_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${YSF2DMR_USER}:${YSF2DMR_GROUP}" -m 0755 /var/log/ysfclients
	
	# Create log file if it doesn't exist
	checkpath -f -o "${YSF2DMR_USER}:${YSF2DMR_GROUP}" -m 0644 "${YSF2DMR_LOGFILE}"
	
	# Create user if it doesn't exist
	if ! id -u "${YSF2DMR_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${YSF2DMR_USER}"
		adduser -D -H -s /sbin/nologin -G "${YSF2DMR_GROUP}" "${YSF2DMR_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${YSF2DMR_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
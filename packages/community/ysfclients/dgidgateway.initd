#!/sbin/openrc-run
# OpenRC init script for DGId Gateway

name="DGId Gateway"
description="DGId Gateway for Amateur Radio digital communications"

# Configuration
: ${DGIDGATEWAY_CONFIG:="/etc/ysfclients/DGIdGateway.ini"}
: ${DGIDGATEWAY_USER:="dgid"}
: ${DGIDGATEWAY_GROUP:="dgid"}
: ${DGIDGATEWAY_LOGFILE:="/var/log/ysfclients/dgidgateway.log"}

command="/usr/bin/DGIdGateway"
command_args="${DGIDGATEWAY_CONFIG}"
command_user="${DGIDGATEWAY_USER}:${DGIDGATEWAY_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args=""

depend() {
	need net
	after firewall
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${DGIDGATEWAY_CONFIG}" ]; then
		eerror "DGIdGateway configuration file ${DGIDGATEWAY_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/ysfclients/DGIdGateway.ini.example ${DGIDGATEWAY_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${DGIDGATEWAY_USER}:${DGIDGATEWAY_GROUP}" -m 0755 /var/log/ysfclients

	# Create user if it doesn't exist
	if ! id -u "${DGIDGATEWAY_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${DGIDGATEWAY_USER}"
		adduser -D -H -s /sbin/nologin -G "${DGIDGATEWAY_GROUP}" "${DGIDGATEWAY_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${DGIDGATEWAY_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
# /etc/conf.d/dstarrepeater
# Configuration file for DStarRepeater OpenRC service

# User and group to run the daemon as
#DSTAR_USER="mmdvm"
#DSTAR_GROUP="mmdvm"

# Path to the DStarRepeater daemon
#DSTAR_DAEMON="/usr/bin/dstarrepeaterd"

# Path to the configuration file
#DSTAR_CONFIG="/etc/dstarrepeater/dstarrepeater.ini"

# Log directory
#DSTAR_LOGDIR="/var/log/dstarrepeater"

# PID file location
#DSTAR_PIDFILE="/run/dstarrepeaterd.pid"

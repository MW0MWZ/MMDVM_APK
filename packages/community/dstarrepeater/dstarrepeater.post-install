#!/bin/sh
# Post-install/upgrade script for dstarrepeater package

# The OpenRC service runs as mmdvm (see /etc/conf.d/dstarrepeater)
getent group mmdvm >/dev/null 2>&1 || addgroup mmdvm
id mmdvm >/dev/null 2>&1 || adduser -D -H -s /sbin/nologin -G mmdvm mmdvm

# Serial port access for the modem, GPIO for PTT on ARM boards
addgroup mmdvm dialout 2>/dev/null || true
case "$(uname -m)" in
	arm*|aarch64)
		getent group gpio >/dev/null 2>&1 && addgroup mmdvm gpio 2>/dev/null || true
		;;
esac

if [ -d /var/log/dstarrepeater ]; then
	find /var/log/dstarrepeater -maxdepth 0 -exec chown mmdvm:mmdvm {} \; 2>/dev/null || true
fi

# Create configuration from the package template if it doesn't exist
if [ ! -f /etc/dstarrepeater/dstarrepeater.ini ] && [ -f /usr/share/dstarrepeater/dstarrepeater.ini.example ]; then
	cp /usr/share/dstarrepeater/dstarrepeater.ini.example /etc/dstarrepeater/dstarrepeater.ini
	echo "Created /etc/dstarrepeater/dstarrepeater.ini from template - edit it to match your setup"
fi

exit 0

#!/sbin/openrc-run
# OpenRC init script for StarNetServer

name="StarNetServer"
description="StarNet Server for D-Star group calls"

# Configuration
: ${STARNETSERVER_CONFIG:="/etc/dstarclients/starnetserver.conf"}
: ${STARNETSERVER_USER:="starnet"}
: ${STARNETSERVER_GROUP:="starnet"}
: ${STARNETSERVER_LOGFILE:="/var/log/dstarclients/starnetserver.log"}

command="/usr/bin/starnetserverd"
command_args="-config ${STARNETSERVER_CONFIG} -daemon"
command_user="${STARNETSERVER_USER}:${STARNETSERVER_GROUP}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args="--stdout ${STARNETSERVER_LOGFILE} --stderr ${STARNETSERVER_LOGFILE}"

depend() {
	need net
	after firewall ircddbgateway
	use logger dns
}

start_pre() {
	# Check if configuration exists
	if [ ! -f "${STARNETSERVER_CONFIG}" ]; then
		eerror "Configuration file ${STARNETSERVER_CONFIG} does not exist"
		eerror "Please create it from: cp /etc/dstarclients/starnetserver.conf.example ${STARNETSERVER_CONFIG}"
		return 1
	fi
	
	# Create log directory if it doesn't exist
	checkpath -d -o "${STARNETSERVER_USER}:${STARNETSERVER_GROUP}" -m 0755 /var/log/dstarclients
	
	# Create log file if it doesn't exist
	checkpath -f -o "${STARNETSERVER_USER}:${STARNETSERVER_GROUP}" -m 0644 "${STARNETSERVER_LOGFILE}"
	
	# Create user if it doesn't exist
	if ! id -u "${STARNETSERVER_USER}" >/dev/null 2>&1; then
		einfo "Creating user ${STARNETSERVER_USER}"
		adduser -D -H -s /sbin/nologin -G "${STARNETSERVER_GROUP}" "${STARNETSERVER_USER}" 2>/dev/null || \
		adduser -D -H -s /sbin/nologin "${STARNETSERVER_USER}" 2>/dev/null
	fi
}

stop_post() {
	# Give the process a moment to clean up
	sleep 1
}

reload() {
	ebegin "Reloading ${name} configuration"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
# Contributor: MW0MWZ <andy@mw0mwz.co.uk>
# Maintainer: MW0MWZ <andy@mw0mwz.co.uk>
pkgname=dstarclients
pkgver=2025.01.01
pkgrel=0
_gitcommit="db7d458"
pkgdesc="D-Star Gateway and tools for digital voice Amateur Radio communications"
url="https://github.com/g4klx/DStarGateway"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	build-base
	git
	linux-headers
	boost-dev
	mosquitto-dev
	nlohmann-json
	"
depends="
	libgcc
	libstdc++
	mosquitto-libs
	"
subpackages="$pkgname-doc $pkgname-openrc"
source=""
options="!check" # No test suite
giturl="https://github.com/g4klx/DStarGateway.git"

# We'll clone the git repo in prepare() instead of using source
prepare() {
	# Clean any existing source
	rm -rf "$srcdir/DStarGateway"

	# Clone the DStarGateway repository
	msg "Cloning DStarGateway from $giturl"
	git clone "$giturl" "$srcdir/DStarGateway"
	cd "$srcdir/DStarGateway"

	local git_version=$(git describe --tags --always)
	msg "DStarGateway git version: $git_version"

	# Apply any other patches if needed
	cd "$srcdir"
	default_prepare || true
}

build() {
	# Build DStarGateway
	cd "$srcdir/DStarGateway"
	msg "Building DStarGateway"

	# Fix missing stdint.h includes for musl libc compatibility
	find . -name "*.h" -o -name "*.cpp" | xargs grep -l "int32_t\|uint32_t\|int16_t\|uint16_t\|int8_t\|uint8_t" | while read file; do
		if ! grep -q "#include <cstdint>\|#include <stdint.h>" "$file"; then
			sed -i '1i#include <cstdint>' "$file"
		fi
	done

	# Fix syntax error in DRATSServer.cpp (misplaced parenthesis in logging)
	if [ -f "Common/DRATSServer.cpp" ]; then
		sed -i 's/CLog::logError("Exception raised in the D-RATS Server thread - \\"%s\\""), message.c_str();/CLog::logError("Exception raised in the D-RATS Server thread - \\"%s\\"", message.c_str());/' Common/DRATSServer.cpp
	fi

	make clean || true
	make \
		CFLAGS="$CFLAGS -DCFG_DIR='\"/etc/dstarclients\"' -DLOG_DIR='\"/var/log/dstarclients\"' -DDATA_DIR='\"/usr/share/dstarclients\"'" \
		CXXFLAGS="$CXXFLAGS -DCFG_DIR='\"/etc/dstarclients\"' -DLOG_DIR='\"/var/log/dstarclients\"' -DDATA_DIR='\"/usr/share/dstarclients\"'" \
		CFG_DIR="/etc/dstarclients" \
		DATA_DIR="/usr/share/dstarclients" \
		LOG_DIR="/var/log/dstarclients" \
		BIN_DIR="/usr/bin" \
		LDFLAGS="$LDFLAGS -lpthread -lmosquitto" \
		LIBS="-lpthread -lmosquitto" \
		-j $(nproc) \
		all
}

package() {
	cd "$srcdir/DStarGateway"

	# Install DStarGateway main binary
	if [ -f "DStarGateway/dstargateway" ]; then
		install -Dm755 "DStarGateway/dstargateway" "$pkgdir/usr/bin/dstargateway"
	fi

	# Install DGWRemoteControl
	if [ -f "DGWRemoteControl/dgwremotecontrol" ]; then
		install -Dm755 "DGWRemoteControl/dgwremotecontrol" "$pkgdir/usr/bin/dgwremotecontrol"
	fi

	# Install DGWTextTransmit
	if [ -f "DGWTextTransmit/dgwtexttransmit" ]; then
		install -Dm755 "DGWTextTransmit/dgwtexttransmit" "$pkgdir/usr/bin/dgwtexttransmit"
	fi

	# Install DGWTimeServer
	if [ -f "DGWTimeServer/dgwtimeserver" ]; then
		install -Dm755 "DGWTimeServer/dgwtimeserver" "$pkgdir/usr/bin/dgwtimeserver"
	fi

	# Install DGWVoiceTransmit
	if [ -f "DGWVoiceTransmit/dgwvoicetransmit" ]; then
		install -Dm755 "DGWVoiceTransmit/dgwvoicetransmit" "$pkgdir/usr/bin/dgwvoicetransmit"
	fi

	# Install DStarGateway configuration files
	if [ -f "DStarGateway/DStarGateway.ini" ]; then
		install -Dm644 "DStarGateway/DStarGateway.ini" "$pkgdir/etc/dstarclients/DStarGateway.ini.example"
	elif [ -f "DStarGateway.ini" ]; then
		install -Dm644 "DStarGateway.ini" "$pkgdir/etc/dstarclients/DStarGateway.ini.example"
	fi

	# Patch default paths and user in the example config
	if [ -f "$pkgdir/etc/dstarclients/DStarGateway.ini.example" ]; then
		sed -i 's|^Data=.*|Data=/usr/share/dstarclients/|' \
			"$pkgdir/etc/dstarclients/DStarGateway.ini.example"
		sed -i 's|^HostsFiles=.*|HostsFiles=/etc/dstarclients/|' \
			"$pkgdir/etc/dstarclients/DStarGateway.ini.example"
		sed -i 's|^User=.*|User=mmdvm|' \
			"$pkgdir/etc/dstarclients/DStarGateway.ini.example"
	fi

	# Install data files from Data directory (voice/audio files only, not host .txt files)
	install -dm755 "$pkgdir/usr/share/dstarclients"
	if [ -d "Data" ]; then
		cd Data
		for file in *.dat *.ambe *.indx; do
			[ -f "$file" ] && install -Dm644 "$file" \
				"$pkgdir/usr/share/dstarclients/$file"
		done
		cd ..
	fi

	# Download current host data from pistar.uk to /etc/dstarclients
	install -dm755 "$pkgdir/etc/dstarclients"
	msg "Downloading DStar_Hosts.json from pistar.uk"
	wget -q -O "$pkgdir/etc/dstarclients/DStar_Hosts.json" \
		"https://www.pistar.uk/downloads/DStar_Hosts.json"

	# Install documentation
	install -dm755 "$pkgdir/usr/share/doc/$pkgname"
	for doc in README* CHANGES* AUTHORS LICENSE *.md; do
		[ -f "$doc" ] && install -Dm644 "$doc" \
			"$pkgdir/usr/share/doc/$pkgname/$doc"
	done

	# Install license file
	mkdir -p "$pkgdir/usr/share/licenses/$pkgname"
	if [ -f LICENSE ]; then
		install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	elif [ -f COPYING ]; then
		install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	elif [ -f LICENSE.txt ]; then
		install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	else
		echo "GPL-2.0-or-later - See upstream repository" > "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	fi

	# Create necessary directories
	install -dm755 "$pkgdir/var/log/dstarclients"

	# Install OpenRC files
	install -Dm755 "$startdir/dstargateway.initd" "$pkgdir/etc/init.d/dstargateway"
	install -Dm644 "$startdir/dstargateway.confd" "$pkgdir/etc/conf.d/dstargateway"
}

doc() {
	default_doc
}

openrc() {
	default_openrc
	install_if="openrc $pkgname=$pkgver-r$pkgrel"
}

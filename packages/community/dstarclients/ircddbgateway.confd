# Configuration for ircDDBGateway service

# Configuration file location
# IRCDDBGATEWAY_CONFIG="/etc/dstarclients/ircddbgateway.conf"

# User and group to run as
# Note: User should be in 'dialout' group for modem access
#       and 'audio' group for voice announcements
# IRCDDBGATEWAY_USER="ircddb"
# IRCDDBGATEWAY_GROUP="ircddb"

# Log file location
# IRCDDBGATEWAY_LOGFILE="/var/log/dstarclients/ircddbgateway.log"